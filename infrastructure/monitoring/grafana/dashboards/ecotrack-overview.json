        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(ecotrack_agent_queries_total[5m])) by (agent_role)",
          "legendFormat": "{{agent_role}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Agent Query Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecotrack_agent_query_duration_seconds_bucket[5m])) by (le, agent_role))",
          "legendFormat": "{{agent_role}} p95",
          "refId": "A"
        }
      ]

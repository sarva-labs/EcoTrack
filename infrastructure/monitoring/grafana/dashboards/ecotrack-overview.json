          "refId": "A"
        },
        {
          "expr": "sum(rate(ecotrack_ml_inference_total[5m])) by (model_name)",
          "legendFormat": "{{model_name}} rate",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Agent Query Metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },

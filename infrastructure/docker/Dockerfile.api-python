FROM python:3.14-slim AS builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    proj-bin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

# Set working directory
WORKDIR /app

# Copy requirements files
COPY packages/core/pyproject.toml packages/core/
COPY packages/geo/pyproject.toml packages/geo/
COPY packages/data-pipeline/pyproject.toml packages/data-pipeline/
COPY packages/ml/pyproject.toml packages/ml/
COPY apps/api-python/pyproject.toml apps/api-python/

# Install dependencies
RUN pip install --upgrade pip && \
    pip install -e packages/core && \
    pip install -e packages/geo && \
    pip install -e packages/data-pipeline && \
    pip install -e packages/ml && \
    pip install -e apps/api-python && \
    pip install gunicorn uvicorn

# Copy source code
COPY packages/core/ecotrack packages/core/ecotrack/
COPY packages/geo/ecotrack_geo packages/geo/ecotrack_geo/
COPY packages/data-pipeline/ecotrack_data packages/data-pipeline/ecotrack_data/
COPY packages/ml/ecotrack_ml packages/ml/ecotrack_ml/
COPY apps/api-python/ecotrack_api apps/api-python/ecotrack_api/

# Create a clean runtime image
FROM python:3.14-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    gdal-bin \
    proj-bin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

# Set working directory
WORKDIR /app

# Copy from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /app /app

# Set permissions
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["gunicorn", "ecotrack_api.main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]
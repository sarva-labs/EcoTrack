# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecotrack
DB_USER=ecotrack
DB_PASSWORD=ecotrack_dev

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3/MinIO configuration
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ecotrack-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Kafka configuration
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Neo4j configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ecotrack_dev

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://ecotrack-dev/models/mlflow-artifacts

# API configuration
API_LOG_LEVEL=DEBUG
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3001

# Feature flags
FF_AGENTS_ENABLED=on
FF_CLIMATE_SCENARIO_EXPLORER=on
# Database configuration
DB_HOST=
DB_PORT=5432
DB_NAME=ecotrack
DB_USER=
DB_PASSWORD=

# Redis configuration
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# S3/MinIO configuration
S3_ENDPOINT=
S3_BUCKET=ecotrack-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Kafka configuration
KAFKA_BROKERS=
SCHEMA_REGISTRY_URL=

# Neo4j configuration
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# MLflow configuration
MLFLOW_TRACKING_URI=
MLFLOW_ARTIFACT_ROOT=

# API configuration
API_LOG_LEVEL=INFO
API_WORKERS=4
API_CORS_ORIGINS=https://www.ecotrack.earth,https://api.ecotrack.earth

# Feature flags
FF_AGENTS_ENABLED=percentage
FF_AGENTS_ENABLED_PERCENTAGE=25.0
FF_CLIMATE_GRAPHCAST_ENSEMBLE=on
FF_CLIMATE_SCENARIO_EXPLORER=on

# Monitoring
PROMETHEUS_ENDPOINT=
GRAFANA_ENDPOINT=
LOKI_ENDPOINT=
JAEGER_ENDPOINT=

# Security
JWT_SECRET=
API_KEY_SALT=
SESSION_SECRET=